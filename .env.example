APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=1200
MOBILITYCLOUD_FINAL_ARCHIVE_RETENTION_HOURS=24

# Encrypted disaster-recovery backups on private S3-compatible storage.
MOBILITYCLOUD_BACKUP_PATH=/var/backups/mobilitycloud
MOBILITYCLOUD_BACKUP_RETENTION_DAYS=7
MOBILITYCLOUD_EXTERNAL_BACKUP_ENABLED=false
MOBILITYCLOUD_EXTERNAL_BACKUP_PREFIX=mobilitycloud
MOBILITYCLOUD_EXTERNAL_BACKUP_KEY_PATH=/etc/mobilitycloud/backup-encryption.key
MOBILITYCLOUD_BACKUP_RESTORE_DATABASE=mobilitycloud_restore_test
MOBILITYCLOUD_BACKUP_S3_KEY=
MOBILITYCLOUD_BACKUP_S3_SECRET=
# Prefer protected files in production so credentials are not stored in .env.
MOBILITYCLOUD_BACKUP_S3_KEY_FILE=
MOBILITYCLOUD_BACKUP_S3_SECRET_FILE=
MOBILITYCLOUD_BACKUP_S3_REGION=auto
MOBILITYCLOUD_BACKUP_S3_BUCKET=
MOBILITYCLOUD_BACKUP_S3_ENDPOINT=
MOBILITYCLOUD_BACKUP_S3_PATH_STYLE=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional public analytics. Use a GA4 Measurement ID such as G-XXXXXXXXXX.
# The public site loads Google Analytics only after Analytics cookie consent.
GOOGLE_ANALYTICS_MEASUREMENT_ID=

# Public-registration bot protection. Generate these in Cloudflare Turnstile
# for mobilitycloud.eu before enabling registration in production.
TURNSTILE_REQUIRED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=mobilitycloud.eu
MOBILITYCLOUD_REGISTRATION_MIN_SECONDS=4
MOBILITYCLOUD_REGISTRATION_MAX_PER_IP_HOUR=3
MOBILITYCLOUD_REGISTRATION_MAX_PER_IP_DAY=8
MOBILITYCLOUD_UNVERIFIED_RETENTION_HOURS=48
